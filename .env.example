# Copy to .env.local and edit. The Node bridge automatically loads .env.local.
# Chromebook first-run safe mode:
DASHBOARD_EMAIL=you@example.com
DASHBOARD_PASSWORD=change-this-long-random-password
MARKET_PROVIDER=synthetic
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
MAX_ORDER_USD=25
ENABLE_LIVE_ORDERS=false
ALLOW_PAPER_ORDERS=true
SESSION_TTL_SECONDS=28800

# Faster DEX Screener candidate scanning; no key needed for current public endpoints.
ALLOWED_CHAINS=solana,base,bsc,ethereum
PROVIDER_CONCURRENCY=6

# Optional live execution webhook you control. Keep secrets here, never in HTML.
# ENABLE_LIVE_ORDERS=true
# LIVE_ORDER_WEBHOOK=https://your-order-service.example/orders
# LIVE_ORDER_AUTH_HEADER=Authorization: Bearer replace-with-your-webhook-secret
# MAX_ORDER_USD=5

# Optional official Axiom Trade API settings, only if Axiom gives you these directly.
# AXIOM_API_BASE=https://official-api-url-from-axiom
# AXIOM_API_TOKEN=replace-with-official-token

# Placeholder for a future Birdeye provider implementation.
# BIRDEYE_API_KEY=replace-with-birdeye-key
